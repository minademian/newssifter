#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check the commit message with commitlint, run from the repo root, where
# commitlint.config.js lives.
# The binary is called directly: `pnpm exec` can start an install, which a hook must not do.
repo_root="$(git rev-parse --show-toplevel)"
commit_msg_file="$1"

case "$commit_msg_file" in
 /*) ;;
 *) commit_msg_file="$repo_root/$commit_msg_file" ;;
esac

if [ ! -x "$repo_root/node_modules/.bin/commitlint" ]; then
  echo "commit-msg: commitlint is not installed in $repo_root. Run pnpm install." >&2
  exit 1
fi

(cd "$repo_root" && ./node_modules/.bin/commitlint --edit "$commit_msg_file") || exit 1
