#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run oxlint with --fix (safe fixes only) on the staged JS/TS files, re-stage what it
# fixed, and stop the commit if problems remain. The command lives in .lintstagedrc.json
# at the repo root.
# The binary is called directly: `pnpm exec` can start an install, which a hook must not do.
repo_root="$(git rev-parse --show-toplevel)"

if [ ! -x "$repo_root/node_modules/.bin/lint-staged" ]; then
  echo "pre-commit: lint-staged is not installed in $repo_root. Run pnpm install." >&2
  exit 1
fi

(cd "$repo_root" && ./node_modules/.bin/lint-staged) || exit 1
