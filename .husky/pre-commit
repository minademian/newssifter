#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run oxlint with --fix (safe fixes only) on the staged JS/TS files, re-stage what it
# fixed, and stop the commit if problems remain. The command lives in .lintstagedrc.json
# in the workspace directory (the one with that file; its name changes per version).
# The binary is called directly: `pnpm exec` can start an install, which a hook must not do.
repo_root="$(git rev-parse --show-toplevel)"

for config in "$repo_root"/*/.lintstagedrc.json; do
  [ -f "$config" ] || continue
  workspace="$(dirname "$config")"

  if [ ! -x "$workspace/node_modules/.bin/lint-staged" ]; then
    echo "pre-commit: lint-staged is not installed in $workspace. Run pnpm install there." >&2
    exit 1
  fi

  (cd "$workspace" && ./node_modules/.bin/lint-staged) || exit 1
done
