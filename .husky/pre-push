#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run the affected tests from the repo root, which is the Nx workspace.
# The binary is called directly: `npx` can download a package, which a hook must not do.
repo_root="$(git rev-parse --show-toplevel)"

if [ ! -x "$repo_root/node_modules/.bin/nx" ]; then
  echo "pre-push: nx is not installed in $repo_root. Run pnpm install." >&2
  exit 1
fi

(cd "$repo_root" && ./node_modules/.bin/nx affected -t test && ./node_modules/.bin/nx affected -t component-test) || exit 1
