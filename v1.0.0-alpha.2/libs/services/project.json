{
  "name": "services",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/services",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/libs/services",
        "main": "libs/services/index.ts",
        "tsConfig": "libs/services/tsconfig.lib.json",
        "webpackConfig": "libs/services/webpack.config.js",
        "assets": []
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
