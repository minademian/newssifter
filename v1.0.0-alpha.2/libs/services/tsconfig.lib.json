{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "ESNext",
    "target": "ES2017",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.it.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "include": ["*.ts"]
}
